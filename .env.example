PORT=YOUR APP PORT
NODE_ENV=development

# Comma separated urls for CORS
CORS=http://localhost:5173,http://localhost:5174,http://localhost:9527,http://127.0.0.1:5173/
# Doon't include www in subdomain URL.
SUBDOMAIN_CORS=https://google.com,http://localhost:5174

# Database setting
DB_HOST=YOUR DATABASE HOST
DB_PORT=YOUR DATABASE PORT
DB_USER=YOUR DATABASE USERNAME
DB_PASSWORD=YOUR DATABASE PASSWORD
DB=YOUR DATABASE NAME

# Mail setting
MAIL_HOST=smtp.gmail.com
MAIL_USER=EMAIL ID
MAIL_PASSWORD=PASSWORD (generated by google)
MAIL_FROM=EMAIL ID
MAIL_SUPPORT=SUPPORT EMAIL(support@example.com)

# Object storage for attachments: s3 (default), gcs, or local (under ./uploads)
STORAGE_TYPE=s3

# AWS S3 — required when STORAGE_TYPE=s3
AWS_REGION=us-east-1
AWS_S3_BUCKET_NAME=your-bucket-name
AWS_ACCESS_KEY_ID=YOUR_AWS_ACCESS_KEY_ID
AWS_SECRET_ACCESS_KEY=YOUR_AWS_SECRET_ACCESS_KEY

# Google Cloud Storage — required when STORAGE_TYPE=gcs
GCS_PROJECT_ID=your-gcp-project-id
GCS_BUCKET_NAME=your-gcs-bucket-name
# Optional: absolute path to a service account JSON key file. If omitted, the client uses Application Default Credentials (e.g. GOOGLE_APPLICATION_CREDENTIALS or gcloud auth).
GCS_KEY_FILE_PATH=

#App settings
APP_URL=APP URL
API_URL=Live api link -- if on local than add ngrok link here
CRON_KEY=KEY_HERE

#Jwt secret key
JWT_SECRET=scret_key